<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="three_r_cad">
  <!--
    CAD-derived planar 3R geometry. STL coordinates are millimetres and are
    scaled to metres below. CAD hole-pattern estimates: 120 / 100 / 60 mm.
    Individual STL exports do not preserve assembly mate transforms.
    Base joint height (47 mm) and pen-tip transform remain provisional.
    Inertias assume uniform density 1200 kg/m^3; replace after weighing parts.
  -->
  <material name="base_metal"><color rgba="0.30 0.34 0.40 1"/></material>
  <material name="link_blue"><color rgba="0.20 0.52 0.78 1"/></material>
  <material name="link_teal"><color rgba="0.22 0.62 0.72 1"/></material>
  <material name="pen_gold"><color rgba="0.88 0.62 0.28 1"/></material>

  <link name="base_link">
    <visual><geometry><mesh filename="package://three_r_description/meshes/Base_Ring.stl" scale="0.001 0.001 0.001"/></geometry><material name="base_metal"/></visual>
    <visual><origin xyz="0 0 0.036"/><geometry><mesh filename="package://three_r_description/meshes/Base_Lid.stl" scale="0.001 0.001 0.001"/></geometry><material name="base_metal"/></visual>
    <collision><geometry><mesh filename="package://three_r_description/meshes/Base_Ring.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <collision><origin xyz="0 0 0.036"/><geometry><mesh filename="package://three_r_description/meshes/Base_Lid.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial>
      <origin xyz="-0.000340 0 0.028776"/>
      <mass value="0.131714"/>
      <inertia ixx="0.0002649474" ixy="-0.0000000001" ixz="-0.0000010693" iyy="0.0002619069" iyz="0" izz="0.0004837742"/>
    </inertial>
  </link>

  <link name="link1">
    <visual><origin xyz="0 0 -0.004"/><geometry><mesh filename="package://three_r_description/meshes/Link1.stl" scale="0.001 0.001 0.001"/></geometry><material name="link_blue"/></visual>
    <collision><origin xyz="0 0 -0.004"/><geometry><mesh filename="package://three_r_description/meshes/Link1.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial>
      <origin xyz="0.066559 -0.000015 -0.000189"/>
      <mass value="0.038986"/>
      <inertia ixx="0.000006260" ixy="-0.000000038" ixz="0.000000301" iyy="0.000070916" iyz="0.000000001" izz="0.000076763"/>
    </inertial>
  </link>

  <link name="link2">
    <visual><origin xyz="0 0 -0.004"/><geometry><mesh filename="package://three_r_description/meshes/Link2.stl" scale="0.001 0.001 0.001"/></geometry><material name="link_teal"/></visual>
    <collision><origin xyz="0 0 -0.004"/><geometry><mesh filename="package://three_r_description/meshes/Link2.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial>
      <origin xyz="0.054871 -0.000017 -0.000214"/>
      <mass value="0.034343"/>
      <inertia ixx="0.000005442" ixy="-0.000000032" ixz="0.000000242" iyy="0.000045824" iyz="0.000000001" izz="0.000050901"/>
    </inertial>
  </link>

  <link name="link3">
    <visual><origin xyz="0 0 -0.011"/><geometry><mesh filename="package://three_r_description/meshes/Link3_PenHolder.stl" scale="0.001 0.001 0.001"/></geometry><material name="pen_gold"/></visual>
    <collision><origin xyz="0 0 -0.011"/><geometry><mesh filename="package://three_r_description/meshes/Link3_PenHolder.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial>
      <origin xyz="0.041044 0.000018 -0.003151"/>
      <mass value="0.031320"/>
      <inertia ixx="0.000003617" ixy="0.000000023" ixz="-0.000002215" iyy="0.000020734" iyz="0.000000003" izz="0.000022054"/>
    </inertial>
  </link>

  <link name="tool0">
    <visual><geometry><sphere radius="0.004"/></geometry><material name="pen_gold"/></visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.047"/><axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="2.0" velocity="2.0"/><dynamics damping="0.06" friction="0.01"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/><origin xyz="0.120 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.443" upper="2.443" effort="1.5" velocity="2.0"/><dynamics damping="0.06" friction="0.01"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/><origin xyz="0.100 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="1.0" velocity="2.5"/><dynamics damping="0.05" friction="0.01"/>
  </joint>
  <!-- Tool point is a temporary 60 mm horizontal / 50 mm downward offset. -->
  <joint name="tool_fixed" type="fixed">
    <parent link="link3"/><child link="tool0"/><origin xyz="0.060 0 -0.050"/>
  </joint>
</robot>
