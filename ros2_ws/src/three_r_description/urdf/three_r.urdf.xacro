<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="three_r">
  <!-- Provisional geometry: update origins, mesh transforms and inertias from CAD. -->
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="dark"><color rgba="0.18 0.18 0.2 1"/></material>

  <link name="base_link">
    <visual><geometry><cylinder radius="0.025" length="0.04"/></geometry><material name="dark"/></visual>
    <collision><geometry><cylinder radius="0.025" length="0.04"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <link name="link1">
    <visual><origin xyz="0.09 0 0"/><geometry><box size="0.18 0.018 0.018"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0.09 0 0"/><geometry><box size="0.18 0.018 0.018"/></geometry></collision>
    <inertial><origin xyz="0.09 0 0"/><mass value="0.20"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.00055" iyz="0" izz="0.00055"/></inertial>
  </link>
  <link name="link2">
    <visual><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.016 0.016"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.016 0.016"/></geometry></collision>
    <inertial><origin xyz="0.06 0 0"/><mass value="0.14"/><inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00018" iyz="0" izz="0.00018"/></inertial>
  </link>
  <link name="link3">
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.014 0.014"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.014 0.014"/></geometry></collision>
    <inertial><origin xyz="0.035 0 0"/><mass value="0.09"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/></inertial>
  </link>
  <link name="tool0"><visual><geometry><sphere radius="0.008"/></geometry><material name="dark"/></visual></link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.02"/><axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="2.0" velocity="2.0"/><dynamics damping="0.08" friction="0.01"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/><origin xyz="0.18 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.443" upper="2.443" effort="1.5" velocity="2.0"/><dynamics damping="0.08" friction="0.01"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/><origin xyz="0.12 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="1.0" velocity="2.5"/><dynamics damping="0.06" friction="0.01"/>
  </joint>
  <joint name="tool_fixed" type="fixed"><parent link="link3"/><child link="tool0"/><origin xyz="0.07 0 0"/></joint>
</robot>
